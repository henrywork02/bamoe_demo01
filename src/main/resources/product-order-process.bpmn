<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI" 
                   xmlns:tns="http://www.jboss.org/drools"
                   id="Definitions_1" 
                   targetNamespace="http://www.jboss.org/drools">
  
  <bpmn2:itemDefinition id="_productOrderItem" structureRef="com.example.model.ProductOrder"/>
  <bpmn2:itemDefinition id="_paymentResultItem" structureRef="com.example.model.PaymentResult"/>
  <bpmn2:itemDefinition id="_serviceOrdersItem" structureRef="java.util.List"/>
  
  <bpmn2:process id="productOrderProcess" name="Product Order Process" isExecutable="true" processType="Public">
    
    <!-- Process Variables -->
    <bpmn2:property id="productOrder" itemSubjectRef="_productOrderItem" name="productOrder"/>
    <bpmn2:property id="paymentResult" itemSubjectRef="_paymentResultItem" name="paymentResult"/>
    <bpmn2:property id="serviceOrders" itemSubjectRef="_serviceOrdersItem" name="serviceOrders"/>
    
    <!-- Start Event -->
    <bpmn2:startEvent id="StartEvent_ProductOrderReceived" name="Product Order 접수">
      <bpmn2:outgoing>Flow_Start_To_Validate</bpmn2:outgoing>
    </bpmn2:startEvent>
    
    <!-- Service Task: Validate Order -->
    <bpmn2:serviceTask id="Task_ValidateOrder" name="Product Order 검증" implementation="Java">
      <bpmn2:incoming>Flow_Start_To_Validate</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Validate_To_Payment</bpmn2:outgoing>
    </bpmn2:serviceTask>
    
    <!-- Business Rule Task: Payment Decision (DMN) -->
    <bpmn2:businessRuleTask id="Task_PaymentDecision" name="결제 발급 (DMN)" implementation="http://www.jboss.org/drools/dmn">
      <bpmn2:extensionElements>
        <tns:onEntry-script scriptFormat="http://www.java.com/java">
          <tns:script></tns:script>
        </tns:onEntry-script>
        <tns:metaData name="elementname">
          <tns:metaValue>결제 발급 (DMN)</tns:metaValue>
        </tns:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Validate_To_Payment</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Payment_To_Gateway</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="Task_PaymentDecision_Input" name="productOrder"/>
        <bpmn2:dataOutput id="Task_PaymentDecision_Output" name="paymentResult"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>Task_PaymentDecision_Input</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>Task_PaymentDecision_Output</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>productOrder</bpmn2:sourceRef>
        <bpmn2:targetRef>Task_PaymentDecision_Input</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>Task_PaymentDecision_Output</bpmn2:sourceRef>
        <bpmn2:targetRef>paymentResult</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:businessRuleTask>
    
    <!-- XOR Gateway: Payment Result -->
    <bpmn2:exclusiveGateway id="Gateway_PaymentResult" name="결제 결과" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_Payment_To_Gateway</bpmn2:incoming>
      <bpmn2:outgoing>Flow_PaymentSuccess</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_PaymentFailed</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    
    <!-- End Event: Payment Failed -->
    <bpmn2:endEvent id="EndEvent_PaymentFailed" name="결제 실패 종료">
      <bpmn2:incoming>Flow_PaymentFailed</bpmn2:incoming>
    </bpmn2:endEvent>
    
    <!-- Service Task: Distribute Service Order -->
    <bpmn2:serviceTask id="Task_DistributeServiceOrder" name="Service Order 분배" implementation="Java">
      <bpmn2:incoming>Flow_PaymentSuccess</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Distribute_To_ParallelStart</bpmn2:outgoing>
    </bpmn2:serviceTask>
    
    <!-- Parallel Gateway: SO Parallel Start -->
    <bpmn2:parallelGateway id="Gateway_SOParallelStart" name="SO 병렬 시작" gatewayDirection="Diverging">
      <bpmn2:incoming>Flow_Distribute_To_ParallelStart</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ParallelStart_To_SO1</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_ParallelStart_To_SO2</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    
    <!-- Sub-Process: Service Order 1 -->
    <bpmn2:subProcess id="SubProcess_ServiceOrder1" name="Service Order 1 처리">
      <bpmn2:incoming>Flow_ParallelStart_To_SO1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_SO1_To_ParallelEnd</bpmn2:outgoing>
      
      <!-- SO1 Start Event -->
      <bpmn2:startEvent id="StartEvent_SO1" name="SO1 시작">
        <bpmn2:outgoing>Flow_SO1Start_To_RO1ParallelStart</bpmn2:outgoing>
      </bpmn2:startEvent>
      
      <!-- SO1 Parallel Gateway: RO Start -->
      <bpmn2:parallelGateway id="Gateway_RO1ParallelStart" name="RO 병렬 시작" gatewayDirection="Diverging">
        <bpmn2:incoming>Flow_SO1Start_To_RO1ParallelStart</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO1ParallelStart_To_RO1_1</bpmn2:outgoing>
        <bpmn2:outgoing>Flow_RO1ParallelStart_To_RO1_2</bpmn2:outgoing>
      </bpmn2:parallelGateway>
      
      <!-- Service Task: Resource Order 1-1 -->
      <bpmn2:serviceTask id="Task_ResourceOrder1_1" name="Resource Order 1-1" implementation="Java">
        <bpmn2:incoming>Flow_RO1ParallelStart_To_RO1_1</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO1_1_To_RO1ParallelEnd</bpmn2:outgoing>
      </bpmn2:serviceTask>
      
      <!-- Service Task: Resource Order 1-2 -->
      <bpmn2:serviceTask id="Task_ResourceOrder1_2" name="Resource Order 1-2" implementation="Java">
        <bpmn2:incoming>Flow_RO1ParallelStart_To_RO1_2</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO1_2_To_RO1ParallelEnd</bpmn2:outgoing>
      </bpmn2:serviceTask>
      
      <!-- SO1 Parallel Gateway: RO End -->
      <bpmn2:parallelGateway id="Gateway_RO1ParallelEnd" name="RO 완료 대기" gatewayDirection="Converging">
        <bpmn2:incoming>Flow_RO1_1_To_RO1ParallelEnd</bpmn2:incoming>
        <bpmn2:incoming>Flow_RO1_2_To_RO1ParallelEnd</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO1ParallelEnd_To_SO1Approval</bpmn2:outgoing>
      </bpmn2:parallelGateway>
      
      <!-- User Task: SO1 Approval -->
      <bpmn2:userTask id="Task_SO1Approval" name="SO1 승인">
        <bpmn2:incoming>Flow_RO1ParallelEnd_To_SO1Approval</bpmn2:incoming>
        <bpmn2:outgoing>Flow_SO1Approval_To_SO1End</bpmn2:outgoing>
      </bpmn2:userTask>
      
      <!-- SO1 End Event -->
      <bpmn2:endEvent id="EndEvent_SO1" name="SO1 완료">
        <bpmn2:incoming>Flow_SO1Approval_To_SO1End</bpmn2:incoming>
      </bpmn2:endEvent>
      
      <!-- SO1 Sequence Flows -->
      <bpmn2:sequenceFlow id="Flow_SO1Start_To_RO1ParallelStart" sourceRef="StartEvent_SO1" targetRef="Gateway_RO1ParallelStart"/>
      <bpmn2:sequenceFlow id="Flow_RO1ParallelStart_To_RO1_1" sourceRef="Gateway_RO1ParallelStart" targetRef="Task_ResourceOrder1_1"/>
      <bpmn2:sequenceFlow id="Flow_RO1ParallelStart_To_RO1_2" sourceRef="Gateway_RO1ParallelStart" targetRef="Task_ResourceOrder1_2"/>
      <bpmn2:sequenceFlow id="Flow_RO1_1_To_RO1ParallelEnd" sourceRef="Task_ResourceOrder1_1" targetRef="Gateway_RO1ParallelEnd"/>
      <bpmn2:sequenceFlow id="Flow_RO1_2_To_RO1ParallelEnd" sourceRef="Task_ResourceOrder1_2" targetRef="Gateway_RO1ParallelEnd"/>
      <bpmn2:sequenceFlow id="Flow_RO1ParallelEnd_To_SO1Approval" sourceRef="Gateway_RO1ParallelEnd" targetRef="Task_SO1Approval"/>
      <bpmn2:sequenceFlow id="Flow_SO1Approval_To_SO1End" sourceRef="Task_SO1Approval" targetRef="EndEvent_SO1"/>
    </bpmn2:subProcess>
    
    <!-- Sub-Process: Service Order 2 -->
    <bpmn2:subProcess id="SubProcess_ServiceOrder2" name="Service Order 2 처리">
      <bpmn2:incoming>Flow_ParallelStart_To_SO2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_SO2_To_ParallelEnd</bpmn2:outgoing>
      
      <!-- SO2 Start Event -->
      <bpmn2:startEvent id="StartEvent_SO2" name="SO2 시작">
        <bpmn2:outgoing>Flow_SO2Start_To_RO2ParallelStart</bpmn2:outgoing>
      </bpmn2:startEvent>
      
      <!-- SO2 Parallel Gateway: RO Start -->
      <bpmn2:parallelGateway id="Gateway_RO2ParallelStart" name="RO 병렬 시작" gatewayDirection="Diverging">
        <bpmn2:incoming>Flow_SO2Start_To_RO2ParallelStart</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO2ParallelStart_To_RO2_1</bpmn2:outgoing>
        <bpmn2:outgoing>Flow_RO2ParallelStart_To_RO2_2</bpmn2:outgoing>
      </bpmn2:parallelGateway>
      
      <!-- Service Task: Resource Order 2-1 -->
      <bpmn2:serviceTask id="Task_ResourceOrder2_1" name="Resource Order 2-1" implementation="Java">
        <bpmn2:incoming>Flow_RO2ParallelStart_To_RO2_1</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO2_1_To_RO2ParallelEnd</bpmn2:outgoing>
      </bpmn2:serviceTask>
      
      <!-- Service Task: Resource Order 2-2 -->
      <bpmn2:serviceTask id="Task_ResourceOrder2_2" name="Resource Order 2-2" implementation="Java">
        <bpmn2:incoming>Flow_RO2ParallelStart_To_RO2_2</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO2_2_To_RO2ParallelEnd</bpmn2:outgoing>
      </bpmn2:serviceTask>
      
      <!-- SO2 Parallel Gateway: RO End -->
      <bpmn2:parallelGateway id="Gateway_RO2ParallelEnd" name="RO 완료 대기" gatewayDirection="Converging">
        <bpmn2:incoming>Flow_RO2_1_To_RO2ParallelEnd</bpmn2:incoming>
        <bpmn2:incoming>Flow_RO2_2_To_RO2ParallelEnd</bpmn2:incoming>
        <bpmn2:outgoing>Flow_RO2ParallelEnd_To_SO2End</bpmn2:outgoing>
      </bpmn2:parallelGateway>
      
      <!-- SO2 End Event -->
      <bpmn2:endEvent id="EndEvent_SO2" name="SO2 완료">
        <bpmn2:incoming>Flow_RO2ParallelEnd_To_SO2End</bpmn2:incoming>
      </bpmn2:endEvent>
      
      <!-- SO2 Sequence Flows -->
      <bpmn2:sequenceFlow id="Flow_SO2Start_To_RO2ParallelStart" sourceRef="StartEvent_SO2" targetRef="Gateway_RO2ParallelStart"/>
      <bpmn2:sequenceFlow id="Flow_RO2ParallelStart_To_RO2_1" sourceRef="Gateway_RO2ParallelStart" targetRef="Task_ResourceOrder2_1"/>
      <bpmn2:sequenceFlow id="Flow_RO2ParallelStart_To_RO2_2" sourceRef="Gateway_RO2ParallelStart" targetRef="Task_ResourceOrder2_2"/>
      <bpmn2:sequenceFlow id="Flow_RO2_1_To_RO2ParallelEnd" sourceRef="Task_ResourceOrder2_1" targetRef="Gateway_RO2ParallelEnd"/>
      <bpmn2:sequenceFlow id="Flow_RO2_2_To_RO2ParallelEnd" sourceRef="Task_ResourceOrder2_2" targetRef="Gateway_RO2ParallelEnd"/>
      <bpmn2:sequenceFlow id="Flow_RO2ParallelEnd_To_SO2End" sourceRef="Gateway_RO2ParallelEnd" targetRef="EndEvent_SO2"/>
    </bpmn2:subProcess>
    
    <!-- Parallel Gateway: SO Parallel End -->
    <bpmn2:parallelGateway id="Gateway_SOParallelEnd" name="SO 완료 대기" gatewayDirection="Converging">
      <bpmn2:incoming>Flow_SO1_To_ParallelEnd</bpmn2:incoming>
      <bpmn2:incoming>Flow_SO2_To_ParallelEnd</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ParallelEnd_To_FinalApproval</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    
    <!-- User Task: Final Approval -->
    <bpmn2:userTask id="Task_FinalApproval" name="Product Order 최종 승인">
      <bpmn2:incoming>Flow_ParallelEnd_To_FinalApproval</bpmn2:incoming>
      <bpmn2:outgoing>Flow_FinalApproval_To_End</bpmn2:outgoing>
    </bpmn2:userTask>
    
    <!-- End Event: Product Order Complete -->
    <bpmn2:endEvent id="EndEvent_ProductOrderComplete" name="Product Order 완료">
      <bpmn2:incoming>Flow_FinalApproval_To_End</bpmn2:incoming>
    </bpmn2:endEvent>
    
    <!-- Main Process Sequence Flows -->
    <bpmn2:sequenceFlow id="Flow_Start_To_Validate" sourceRef="StartEvent_ProductOrderReceived" targetRef="Task_ValidateOrder"/>
    <bpmn2:sequenceFlow id="Flow_Validate_To_Payment" sourceRef="Task_ValidateOrder" targetRef="Task_PaymentDecision"/>
    <bpmn2:sequenceFlow id="Flow_Payment_To_Gateway" sourceRef="Task_PaymentDecision" targetRef="Gateway_PaymentResult"/>
    <bpmn2:sequenceFlow id="Flow_PaymentSuccess" name="결제 성공" sourceRef="Gateway_PaymentResult" targetRef="Task_DistributeServiceOrder">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return paymentResult.getApproved() == true;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_PaymentFailed" name="결제 실패" sourceRef="Gateway_PaymentResult" targetRef="EndEvent_PaymentFailed">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" language="http://www.java.com/java">return paymentResult.getApproved() == false;</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Distribute_To_ParallelStart" sourceRef="Task_DistributeServiceOrder" targetRef="Gateway_SOParallelStart"/>
    <bpmn2:sequenceFlow id="Flow_ParallelStart_To_SO1" sourceRef="Gateway_SOParallelStart" targetRef="SubProcess_ServiceOrder1"/>
    <bpmn2:sequenceFlow id="Flow_ParallelStart_To_SO2" sourceRef="Gateway_SOParallelStart" targetRef="SubProcess_ServiceOrder2"/>
    <bpmn2:sequenceFlow id="Flow_SO1_To_ParallelEnd" sourceRef="SubProcess_ServiceOrder1" targetRef="Gateway_SOParallelEnd"/>
    <bpmn2:sequenceFlow id="Flow_SO2_To_ParallelEnd" sourceRef="SubProcess_ServiceOrder2" targetRef="Gateway_SOParallelEnd"/>
    <bpmn2:sequenceFlow id="Flow_ParallelEnd_To_FinalApproval" sourceRef="Gateway_SOParallelEnd" targetRef="Task_FinalApproval"/>
    <bpmn2:sequenceFlow id="Flow_FinalApproval_To_End" sourceRef="Task_FinalApproval" targetRef="EndEvent_ProductOrderComplete"/>
    
  </bpmn2:process>
  
  <!-- BPMN Diagram Information (Optional - for visual layout) -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="productOrderProcess">
      <!-- Diagram elements would be added here by BPMN editors -->
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</bpmn2:definitions>

