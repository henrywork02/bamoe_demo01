<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="Definitions_SO2"
                   targetNamespace="http://www.example.org/bamoe/service-order-2"
                   exporter="BAMOE"
                   exporterVersion="9.1.0">
  
  <bpmn2:process id="ServiceOrder2Subprocess" name="Service Order 2 처리" isExecutable="true" drools:packageName="com.example.productorder.subprocess">
    
    <!-- Process Variables -->
    <bpmn2:property id="serviceOrder2" name="serviceOrder2" itemSubjectRef="ItemDefinition_ServiceOrder"/>
    <bpmn2:property id="resourceOrders" name="resourceOrders" itemSubjectRef="ItemDefinition_ResourceOrderList"/>
    <bpmn2:property id="ro21Result" name="ro21Result" itemSubjectRef="ItemDefinition_String"/>
    <bpmn2:property id="ro22Result" name="ro22Result" itemSubjectRef="ItemDefinition_String"/>
    
    <!-- Start Event -->
    <bpmn2:startEvent id="StartEvent_SO2" name="S02 시작">
      <bpmn2:outgoing>SequenceFlow_SO2_1</bpmn2:outgoing>
    </bpmn2:startEvent>
    
    <!-- Parallel Gateway: RO 발생 시작 -->
    <bpmn2:parallelGateway id="ParallelGateway_RO2_Start" name="RO 발생 시작" gatewayDirection="Diverging">
      <bpmn2:incoming>SequenceFlow_SO2_1</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_RO21</bpmn2:outgoing>
      <bpmn2:outgoing>SequenceFlow_RO22</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    
    <!-- Service Task: Resource Order 2-1 -->
    <bpmn2:serviceTask id="ServiceTask_RO21" name="Resource Order 2-1" drools:taskName="ProcessResourceOrder21">
      <bpmn2:incoming>SequenceFlow_RO21</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_RO21_Complete</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_RO21" name="resourceOrder21"/>
        <bpmn2:dataOutput id="DataOutput_RO21" name="ro21Result"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>DataInput_RO21</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>DataOutput_RO21</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
    </bpmn2:serviceTask>
    
    <!-- Service Task: Resource Order 2-2 -->
    <bpmn2:serviceTask id="ServiceTask_RO22" name="Resource Order 2-2" drools:taskName="ProcessResourceOrder22">
      <bpmn2:incoming>SequenceFlow_RO22</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_RO22_Complete</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="DataInput_RO22" name="resourceOrder22"/>
        <bpmn2:dataOutput id="DataOutput_RO22" name="ro22Result"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>DataInput_RO22</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>DataOutput_RO22</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
    </bpmn2:serviceTask>
    
    <!-- Parallel Gateway: RO 완료 대기 -->
    <bpmn2:parallelGateway id="ParallelGateway_RO2_End" name="RO 완료 대기" gatewayDirection="Converging">
      <bpmn2:incoming>SequenceFlow_RO21_Complete</bpmn2:incoming>
      <bpmn2:incoming>SequenceFlow_RO22_Complete</bpmn2:incoming>
      <bpmn2:outgoing>SequenceFlow_SO2_2</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    
    <!-- End Event -->
    <bpmn2:endEvent id="EndEvent_SO2" name="S02 완료">
      <bpmn2:incoming>SequenceFlow_SO2_2</bpmn2:incoming>
    </bpmn2:endEvent>
    
    <!-- Sequence Flows -->
    <bpmn2:sequenceFlow id="SequenceFlow_SO2_1" sourceRef="StartEvent_SO2" targetRef="ParallelGateway_RO2_Start"/>
    <bpmn2:sequenceFlow id="SequenceFlow_RO21" sourceRef="ParallelGateway_RO2_Start" targetRef="ServiceTask_RO21"/>
    <bpmn2:sequenceFlow id="SequenceFlow_RO22" sourceRef="ParallelGateway_RO2_Start" targetRef="ServiceTask_RO22"/>
    <bpmn2:sequenceFlow id="SequenceFlow_RO21_Complete" sourceRef="ServiceTask_RO21" targetRef="ParallelGateway_RO2_End"/>
    <bpmn2:sequenceFlow id="SequenceFlow_RO22_Complete" sourceRef="ServiceTask_RO22" targetRef="ParallelGateway_RO2_End"/>
    <bpmn2:sequenceFlow id="SequenceFlow_SO2_2" sourceRef="ParallelGateway_RO2_End" targetRef="EndEvent_SO2"/>
    
  </bpmn2:process>
  
  <!-- Item Definitions -->
  <bpmn2:itemDefinition id="ItemDefinition_ServiceOrder" structureRef="com.example.productorder.model.ServiceOrder"/>
  <bpmn2:itemDefinition id="ItemDefinition_ResourceOrderList" structureRef="java.util.List"/>
  <bpmn2:itemDefinition id="ItemDefinition_String" structureRef="java.lang.String"/>
  
  <!-- BPMN Diagram (Visual Layout) -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_SO2">
    <bpmndi:BPMNPlane id="BPMNPlane_SO2" bpmnElement="ServiceOrder2Subprocess">
      
      <!-- Start Event -->
      <bpmndi:BPMNShape id="StartEvent_SO2_di" bpmnElement="StartEvent_SO2">
        <dc:Bounds x="100" y="200" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="90" y="243" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Parallel Gateway: RO Start -->
      <bpmndi:BPMNShape id="ParallelGateway_RO2_Start_di" bpmnElement="ParallelGateway_RO2_Start">
        <dc:Bounds x="200" y="193" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="190" y="250" width="70" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Service Task: RO 2-1 -->
      <bpmndi:BPMNShape id="ServiceTask_RO21_di" bpmnElement="ServiceTask_RO21">
        <dc:Bounds x="320" y="100" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <!-- Service Task: RO 2-2 -->
      <bpmndi:BPMNShape id="ServiceTask_RO22_di" bpmnElement="ServiceTask_RO22">
        <dc:Bounds x="320" y="260" width="100" height="80"/>
      </bpmndi:BPMNShape>
      
      <!-- Parallel Gateway: RO End -->
      <bpmndi:BPMNShape id="ParallelGateway_RO2_End_di" bpmnElement="ParallelGateway_RO2_End">
        <dc:Bounds x="500" y="193" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="490" y="250" width="70" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- End Event -->
      <bpmndi:BPMNShape id="EndEvent_SO2_di" bpmnElement="EndEvent_SO2">
        <dc:Bounds x="620" y="200" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="610" y="243" width="56" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      
      <!-- Sequence Flow Edges -->
      <bpmndi:BPMNEdge id="SequenceFlow_SO2_1_di" bpmnElement="SequenceFlow_SO2_1">
        <di:waypoint x="136" y="218"/>
        <di:waypoint x="200" y="218"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_RO21_di" bpmnElement="SequenceFlow_RO21">
        <di:waypoint x="225" y="193"/>
        <di:waypoint x="225" y="140"/>
        <di:waypoint x="320" y="140"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_RO22_di" bpmnElement="SequenceFlow_RO22">
        <di:waypoint x="225" y="243"/>
        <di:waypoint x="225" y="300"/>
        <di:waypoint x="320" y="300"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_RO21_Complete_di" bpmnElement="SequenceFlow_RO21_Complete">
        <di:waypoint x="420" y="140"/>
        <di:waypoint x="525" y="140"/>
        <di:waypoint x="525" y="193"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_RO22_Complete_di" bpmnElement="SequenceFlow_RO22_Complete">
        <di:waypoint x="420" y="300"/>
        <di:waypoint x="525" y="300"/>
        <di:waypoint x="525" y="243"/>
      </bpmndi:BPMNEdge>
      
      <bpmndi:BPMNEdge id="SequenceFlow_SO2_2_di" bpmnElement="SequenceFlow_SO2_2">
        <di:waypoint x="550" y="218"/>
        <di:waypoint x="620" y="218"/>
      </bpmndi:BPMNEdge>
      
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  
</bpmn2:definitions>

<!-- Made with Bob -->
